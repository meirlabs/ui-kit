{
  "name": "@meir-labs/ui-kit",
  "version": "0.3.0",
  "description": "Themeable (light & dark) presentational component library for React",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./virtual": {
      "import": "./dist/virtual.js",
      "types": "./dist/virtual.d.ts"
    },
    "./sortable": {
      "import": "./dist/sortable.js",
      "types": "./dist/sortable.d.ts"
    },
    "./charts": {
      "import": "./dist/charts.js",
      "types": "./dist/charts.d.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./compat.css": "./dist/compat.css"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "./dist/compat.css"
  ],
  "scripts": {
    "build": "tsup && postcss src/styles/index.css -o dist/styles.css && postcss src/styles/compat.css -o dist/compat.css",
    "prepublishOnly": "npm run build",
    "prepare": "[ -f tsup.config.ts ] && npm run build || true",
    "dev": "concurrently \"tsup --watch\" \"postcss src/styles/index.css -o dist/styles.css --watch\" \"postcss src/styles/compat.css -o dist/compat.css --watch\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run",
    "preview": "vite --config preview/vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "refine": "npx transitions-refine live"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "liveline": "^0.0.7",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-virtuoso": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-virtuoso": {
      "optional": true
    },
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "liveline": {
      "optional": true
    }
  },
  "dependencies": {
    "@number-flow/react": "^0.6.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@storybook/react-vite": "^10.3.3",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.0",
    "jsdom": "^25.0.0",
    "liveline": "^0.0.7",
    "postcss": "^8.5.0",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-virtuoso": "^4.18.10",
    "storybook": "^10.3.3",
    "transitions-refine": "^0.3.23",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meirlabs/ui-kit.git"
  },
  "homepage": "https://github.com/meirlabs/ui-kit#readme",
  "bugs": "https://github.com/meirlabs/ui-kit/issues",
  "publishConfig": {
    "access": "public"
  }
}
